# ============================================================
# TEMPLATE KONFIGURASI .env UNTUK CPANEL
# ============================================================
# 
# File ini adalah template untuk konfigurasi .env di server cPanel
# Salin isi file ini ke file .env di server production
#
# CARA PENGGUNAAN:
# 1. Login ke cPanel
# 2. Buka MySQL® Databases untuk mendapatkan kredensial
# 3. Edit file .env di server via File Manager
# 4. Ganti value yang ada tag [GANTI_INI] dengan nilai sebenarnya
# 5. Simpan file .env
# 6. Clear cache Laravel
# ============================================================

APP_NAME="Website Kabupaten Sanggau"
APP_ENV=production
APP_KEY=base64:8jNXeaVtoLJIQwIg6d6bneycgF+bSB/qELglQrggxDM=
APP_DEBUG=false
APP_URL=https://api.diskominfo.sanggau.go.id

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ============================================================
# DATABASE CONFIGURATION - PRODUCTION (cPanel)
# ============================================================
# PENTING: Dapatkan kredensial ini dari cPanel → MySQL® Databases
# 
# Format nama database di cPanel biasanya:
#   - Dengan prefix: username_namadb
#   - Contoh: diskomin_sanggau_db
#
# Format username database di cPanel biasanya:
#   - Dengan prefix: username_dbuser
#   - Contoh: diskomin_sanggau_user
#
# Pastikan database user sudah di-assign ke database dan punya ALL PRIVILEGES
# ============================================================

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=[GANTI_INI_DENGAN_NAMA_DATABASE_DARI_CPANEL]
DB_USERNAME=[GANTI_INI_DENGAN_USERNAME_DATABASE_DARI_CPANEL]
DB_PASSWORD=[GANTI_INI_DENGAN_PASSWORD_DATABASE_DARI_CPANEL]

# ============================================================
# CACHE & SESSION CONFIGURATION
# ============================================================
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================================
# MAIL CONFIGURATION
# ============================================================
# Opsional: Isi jika ingin mengaktifkan fitur email
# Biasanya menggunakan mail server dari cPanel
# ============================================================
MAIL_MAILER=smtp
MAIL_HOST=mail.diskominfo.sanggau.go.id
MAIL_PORT=465
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@diskominfo.sanggau.go.id
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# CORS & SESSION CONFIGURATION
# ============================================================
# Untuk API yang diakses dari frontend yang berbeda domain
# ============================================================
SANCTUM_STATEFUL_DOMAINS=diskominfo.sanggau.go.id,www.diskominfo.sanggau.go.id
SESSION_DOMAIN=.sanggau.go.id

# ============================================================
# AWS S3 (Optional - untuk cloud storage)
# ============================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================================
# PUSHER (Optional - untuk real-time features)
# ============================================================
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ============================================================
# CHECKLIST SEBELUM DEPLOY:
# ============================================================
# 
# [ ] DB_HOST = localhost (BUKAN 127.0.0.1)
# [ ] DB_DATABASE sudah diganti dengan nama database dari cPanel
# [ ] DB_USERNAME sudah diganti dengan username dari cPanel
# [ ] DB_PASSWORD sudah diganti dengan password yang benar
# [ ] APP_ENV = production
# [ ] APP_DEBUG = false
# [ ] APP_KEY sudah di-generate (jangan ganti yang sudah ada)
# [ ] Tidak ada spasi di awal/akhir setiap value
# [ ] Save file dengan nama .env (BUKAN .env.cpanel-template)
# [ ] Clear cache setelah save: php artisan config:clear
# 
# ============================================================
